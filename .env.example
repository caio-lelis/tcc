# Copie este arquivo para .env e preencha. O .env não vai para o git.

# Chave da API da OpenAI
OPENAI_API_KEY=

# Modelo fixo do experimento (RNF03). Usar a versão datada (snapshot) quando definida.
OPENAI_MODEL=gpt-5.6-terra

# Esforço de raciocínio, fixo no experimento: low, medium ou high. Vazio = padrão do modelo.
OPENAI_ESFORCO=low

# Relatórios ao vivo (opcional). Sem isto valem senhas locais de desenvolvimento,
# aceitáveis porque Postgres e MinIO não publicam portas. Em servidor, defina as três.
# DATA_TALK_POSTGRES_SENHA=
# DATA_TALK_MINIO_USUARIO=
# DATA_TALK_MINIO_SENHA=
